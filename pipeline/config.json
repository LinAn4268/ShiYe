{
  "version": "1.0.0",
  "http": {
    "timeout_ms": 20000,
    "max_bytes": 4000000,
    "max_redirects": 5,
    "user_agent": "KuayuPipeline/1.0 (content index; contact: site-owner@example.invalid)",
    "robots_cache_hours": 24
  },
  "llm": {
    "endpoint": "https://api.openai.com/v1/chat/completions",
    "model": "gpt-4o-mini",
    "api_key_env": "KUAYU_LLM_API_KEY",
    "timeout_ms": 120000,
    "max_retries": 1,
    "temperature": 0,
    "response_format": true,
    "max_input_chars": 12000
  },
  "dedupe": {
    "fuzzy": {
      "method": "simhash",
      "enabled": true,
      "max_distance": 3,
      "suspect_min_distance": 4,
      "suspect_max_distance": 5,
      "min_tokens": 20,
      "fallback_to_title": false
    }
  },
  "health": {
    "failure_threshold": 5,
    "low_activity_days": 7,
    "recheck_days": 90
  },
  "publish": {
    "lock_timeout_ms": 15000,
    "lock_stale_ms": 1800000,
    "history_limit": 20,
    "rebuild_fallback": true
  },
  "routing": {
    "nasa": {
      "category": "science-nature",
      "language": "en",
      "tags": ["天文"],
      "interval_minutes": 120,
      "routes": [
        { "pattern": "mangrove|earth\\b|climate|landsat|ocean|wildfire|earth observatory", "category": "science-nature", "tags": ["地球观测"] },
        { "pattern": "gemini|apollo|history|historic|photograph", "category": "humanities-history", "tags": ["航天史"] },
        { "pattern": "i am artemis|career|engineer|workforce|intern", "category": "career-growth", "tags": ["航天人才"] },
        { "pattern": "hubble|roman|space|rocket|moon|mars|artemis", "category": "science-nature", "tags": ["天文"] }
      ]
    },
    "nist": {
      "category": "tech-ai",
      "language": "en",
      "tags": ["网络安全"],
      "interval_minutes": 60,
      "routes": [
        { "pattern": "quantum|photon|sensor", "category": "future-frontier", "tags": ["量子技术"] },
        { "pattern": "timekeeping|clock|chip-based", "category": "future-frontier", "tags": ["时间计量"] },
        { "pattern": "identity|access token|authentication|password", "category": "law-privacy", "tags": ["数字身份"] },
        { "pattern": "post-quantum|cryptograph|cybersecurity|cyber", "category": "tech-ai", "tags": ["后量子密码"] }
      ]
    },
    "owid": {
      "category": "society-policy",
      "language": "en",
      "tags": ["公共治理"],
      "interval_minutes": 60,
      "routes": [
        { "pattern": "mental|health|malaria|vaccine|wellbeing|suicide", "category": "health-wellbeing", "tags": ["公共卫生"] },
        { "pattern": "organic|food|farming|agriculture", "category": "food-agriculture", "tags": ["有机农业"] },
        { "pattern": "climate|energy|wildlife|biodiversity|deforestation|forest|environment", "category": "environment-sustainability", "tags": ["生物多样性"] },
        { "pattern": "artificial intelligence|\\bai\\b|technology|internet|smartphone", "category": "tech-ai", "tags": ["人工智能"] },
        { "pattern": "immigration|migration|policy|government|development aid", "category": "society-policy", "tags": ["移民"] }
      ]
    },
    "govuk": {
      "category": "society-policy",
      "language": "en",
      "tags": ["公共治理"],
      "interval_minutes": 60,
      "routes": [
        { "pattern": "job|employment|work|young people|skills", "category": "society-policy", "tags": ["就业政策"] },
        { "pattern": "saving|pension|money|finance|wage", "category": "business-finance", "tags": ["个人理财"] },
        { "pattern": "food|drink|manufactur|export|brexit", "category": "food-agriculture", "tags": ["食品贸易"] },
        { "pattern": "waste|environment|climate|water|flood", "category": "environment-sustainability", "tags": ["循环经济"] },
        { "pattern": "abortion|pardon|court|justice|offence", "category": "society-policy", "tags": ["司法"] }
      ]
    },
    "gds": {
      "category": "design-creative",
      "language": "en",
      "tags": ["服务设计"],
      "interval_minutes": 120,
      "routes": [
        { "pattern": "wallet|digital identity|verification|identity", "category": "product-operations", "tags": ["数字身份"] },
        { "pattern": "service standard|assessment|delivery", "category": "product-operations", "tags": ["服务标准"] },
        { "pattern": "sign in|sign-in|passkey|login|accessibility", "category": "design-creative", "tags": ["用户体验"] }
      ]
    },
    "openstax": {
      "category": "education-learning",
      "language": "en",
      "tags": ["开放教育资源"],
      "interval_minutes": 1440,
      "routes": [
        { "pattern": "assignable|quiz|question|courseware", "category": "education-learning", "tags": ["教学工具"] },
        { "pattern": "textbook|oer|open educational|access", "category": "education-learning", "tags": ["开放教育资源"] }
      ]
    },
    "unesco": {
      "category": "arts-culture",
      "language": "en",
      "tags": ["世界遗产"],
      "interval_minutes": 720,
      "routes": [
        { "pattern": "world heritage|heritage|committee", "category": "arts-culture", "tags": ["世界遗产"] },
        { "pattern": "education|learning|school", "category": "education-learning", "tags": ["高等教育"] }
      ]
    },
    "who": {
      "category": "health-wellbeing",
      "language": "en",
      "tags": ["公共卫生"],
      "interval_minutes": 720,
      "routes": [
        { "pattern": "physical activity|exercise|walking", "category": "health-wellbeing", "tags": ["身体活动"] },
        { "pattern": "self-care|self care|testing|treatment", "category": "health-wellbeing", "tags": ["自我照护"] },
        { "pattern": "climate|heat|air pollution", "category": "health-wellbeing", "tags": ["气候健康"] }
      ]
    },
    "nps": {
      "category": "travel-geography",
      "language": "en",
      "tags": ["国家公园"],
      "interval_minutes": 720,
      "routes": [
        { "pattern": "volcano|lava|eruption|geolog", "category": "travel-geography", "tags": ["地质"] },
        { "pattern": "denali|road|trail|access|bus|visit", "category": "travel-geography", "tags": ["国家公园"] }
      ]
    },
    "loc": {
      "category": "arts-culture",
      "language": "en",
      "tags": ["展览"],
      "interval_minutes": 1440,
      "routes": [
        { "pattern": "watercolor|architecture|architect", "category": "arts-culture", "tags": ["建筑绘图"] },
        { "pattern": "super mario|video game|game music|recording", "category": "games-entertainment", "tags": ["游戏音乐"] },
        { "pattern": "folklife|folk|oral history|archive", "category": "arts-culture", "tags": ["民俗"] }
      ]
    },
    "python": {
      "category": "programming-open-source",
      "language": "en",
      "tags": ["Python"],
      "interval_minutes": 360,
      "routes": [
        { "pattern": "alpha|beta|release|version", "category": "programming-open-source", "tags": ["版本发布"] },
        { "pattern": "performance|faster|speed|startup", "category": "programming-open-source", "tags": ["性能"] }
      ]
    },
    "wikimedia": {
      "category": "media-communication",
      "language": "en",
      "tags": ["平台治理"],
      "interval_minutes": 360,
      "routes": [
        { "pattern": "enterprise|api|license|knowledge|free", "category": "media-communication", "tags": ["知识共享"] },
        { "pattern": "openai|agent|ai|scrap|crawler", "category": "media-communication", "tags": ["AI与媒体"] },
        { "pattern": "copyright|policy|governance|platform", "category": "media-communication", "tags": ["平台治理"] }
      ]
    }
  }
}
